name: Build APK

on:
  workflow_dispatch:
  push:
    branches:
      - main

jobs:
  build:
    runs-on: ubuntu-latest
    timeout-minutes: 45

    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Extract project ZIP
        run: |
          set -e
          ZIP=""
          for f in NOVA_FF_ARENA_READY_TO_BUILD.zip NOVA_FF_ARENA_PERFECT_BUILD_FIXED.zip NOVA_FF_ARENA_PERFECT_BUILD_FIXED_CORRECTED.zip; do
            if [ -f "$f" ]; then ZIP="$f"; break; fi
          done
          if [ -z "$ZIP" ]; then
            ZIP=$(ls -1 *.zip 2>/dev/null | head -1 || true)
          fi
          if [ -z "$ZIP" ]; then
            echo "No project ZIP found"
            ls -la
            exit 1
          fi
          echo "Using ZIP: $ZIP"
          rm -rf _project
          unzip -q -o "$ZIP" -d _project
          if [ -d "_project/NOVA_FF_ARENA_FINAL" ]; then
            cp -a _project/NOVA_FF_ARENA_FINAL/. .
          elif [ -f "_project/pubspec.yaml" ]; then
            cp -a _project/. .
          else
            INNER=$(find _project -maxdepth 3 -name pubspec.yaml | head -1 | xargs -r dirname)
            cp -a "$INNER"/. .
          fi
          rm -rf _project
          test -f pubspec.yaml || { echo "pubspec.yaml missing"; ls -la; exit 1; }
          echo "Project extracted OK"

      - name: Set up Java 17
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: "17"

      - name: Set up Flutter
        uses: subosito/flutter-action@v2
        with:
          channel: stable
          cache: true

      - name: Flutter doctor
        run: flutter doctor -v

      - name: Fix Android Gradle files
        run: |
          set -e
          mkdir -p android
          python3 << 'PY'
          from pathlib import Path
          settings = '''pluginManagement {
              def flutterSdkPath = {
                  def properties = new Properties()
                  file("local.properties").withInputStream { properties.load(it) }
                  def path = properties.getProperty("flutter.sdk")
                  assert path != null, "flutter.sdk not set in local.properties"
                  return path
              }()

              includeBuild("$flutterSdkPath/packages/flutter_tools/gradle")

              repositories {
                  google()
                  mavenCentral()
                  gradlePluginPortal()
              }
          }

          plugins {
              id "dev.flutter.flutter-plugin-loader" version "1.0.0"
              id "com.android.application" version "8.7.3" apply false
              id "org.jetbrains.kotlin.android" version "2.0.21" apply false
          }

          include ":app"
          '''
          build_gradle = '''allprojects {
              repositories {
                  google()
                  mavenCentral()
              }
          }

          rootProject.buildDir = "../build"

          subprojects {
              project.buildDir = "${rootProject.buildDir}/${project.name}"
          }

          subprojects {
              project.evaluationDependsOn(":app")
          }

          tasks.register("clean", Delete) {
              delete rootProject.buildDir
          }
          '''
          props = '''org.gradle.jvmargs=-Xmx4G -XX:MaxMetaspaceSize=2G -XX:+HeapDumpOnOutOfMemoryError
          android.useAndroidX=true
          android.enableJetifier=true
          kotlin.code.style=official
          '''
          Path("android/settings.gradle").write_text(settings)
          Path("android/build.gradle").write_text(build_gradle)
          Path("android/gradle.properties").write_text(props.replace("          ", ""))
          print("Gradle files written OK")
          PY

      - name: Ensure Android platform
        run: |
          flutter create . --platforms=android --project-name nova_ff_arena --org com.novaffarena || true
          python3 << 'PY'
          from pathlib import Path
          settings = '''pluginManagement {
              def flutterSdkPath = {
                  def properties = new Properties()
                  file("local.properties").withInputStream { properties.load(it) }
                  def path = properties.getProperty("flutter.sdk")
                  assert path != null, "flutter.sdk not set in local.properties"
                  return path
              }()

              includeBuild("$flutterSdkPath/packages/flutter_tools/gradle")

              repositories {
                  google()
                  mavenCentral()
                  gradlePluginPortal()
              }
          }

          plugins {
              id "dev.flutter.flutter-plugin-loader" version "1.0.0"
              id "com.android.application" version "8.7.3" apply false
              id "org.jetbrains.kotlin.android" version "2.0.21" apply false
          }

          include ":app"
          '''
          Path("android/settings.gradle").write_text(settings)
          print("settings.gradle re-applied")
          PY

      - name: Install dependencies
        run: flutter pub get

      - name: Build debug APK
        run: flutter build apk --debug

      - name: Upload APK
        uses: actions/upload-artifact@v4
        with:
          name: nova-ff-arena-apk
          path: build/app/outputs/flutter-apk/app-debug.apk
          if-no-files-found: error
          retention-days: 14
